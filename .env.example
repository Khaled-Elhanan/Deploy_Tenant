# Tenantix Platform - Environment Variables Reference
# ====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ====================================================

# --- Database (PostgreSQL) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tenantix_platform;Username=tenantix;Password=YOUR_PASSWORD

# --- JWT Authentication ---
JwtSettings__Secret=YOUR_256_BIT_SECRET_KEY_HERE_MIN_32_CHARS
JwtSettings__TokenExpiryTimeInMinutes=30
JwtSettings__RefreshTokenExpiryTimeInDays=7

# --- CORS ---
CorsSettings__AllowedOrigins__0=https://your-frontend.com
CorsSettings__AllowedOrigins__1=https://admin.your-frontend.com

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
